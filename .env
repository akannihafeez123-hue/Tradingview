# ═══════════════════════════════════════════════════════════════════════════
# WISPBYTE — DISABLE EVERYTHING EXCEPT WYCKOFF, APEX, LIMITBOT
# ═══════════════════════════════════════════════════════════════════════════

# ── Engines to KEEP ───────────────────────────────────────────────────────
WYCKOFF_ENGINE_ENABLED=1
WYCKOFF_SWING_ENGINE_ENABLED=1
APEX_ENGINE_ENABLED=1
APEX_SOVEREIGN_ENABLED=0          # turn OFF — pure CPU cost
LIMITBOT_AUTO_ENABLED=1

# ── Engines to KILL (all of these were burning CPU) ──────────────────────
CONT_ENABLED=0                    # v1 classifier off
CONT2_ENABLED=0                   # v2 hunter off
AUTO_MAIN_BRAIN_ENABLED=0         # Main Brain scout off
VAULT_AUTO_ENABLED=0              # Vault auto-scan off
DECISION_AUTO_SCAN=false          # /decision auto-scan off
AUTO_SCANNER_ENABLED=0            # legacy auto-scanner off
BREAKOUT_ENABLED=0                # Kraken/Breakout bridge off
MECH_EXECUTION_ENABLED=0          # BOS watcher off  ← critical
INSTITUTIONAL_WATCH_INTERVAL_MS=0 # institutional watch off
KERAS_BRAIN_DISABLED=1            # see note below
ENABLE_MARKET_WEBSOCKETS=false
ENABLE_TRADE_WEBSOCKETS=false

# ── Reduced scan frequency ───────────────────────────────────────────────
WYCKOFF_SCAN_INTERVAL_MS=1800000      # 30 min (was 15)
WYCKOFF_SCAN_BATCH_SIZE=20            # 20 symbols per cycle (was 50)
WYCKOFF_SWING_SCAN_INTERVAL_MS=7200000 # 2 h (was 30 min)
WYCKOFF_SWING_SCAN_BATCH_SIZE=15
APEX_SCAN_INTERVAL_MS=1800000         # 30 min (was 5)
APEX_SCAN_BATCH_SIZE=20
APEX_SCAN_CONCURRENCY=2               # drop to 2 workers
LIMITBOT_AUTO_INTERVAL_MS=3600000     # 1 h (was 30 min)
LIMITBOT_AUTO_MIN_QUALITY=85          # 85 %+ only

# ── Coin universe trim (main CPU saver) ──────────────────────────────────
MAX_SYMBOLS_WATCH=40                  # was 500
MIN_SYMBOL_VOLUME=5000000             # $5 M min volume (was $1 M)
LOW_BANDWIDTH_MODE=true               # already default, but explicit

# ── HTTP + storage (Wispbyte disk is 1 GB) ───────────────────────────────
STORAGE_TOTAL_MAX_MB=200              # was 4096 — 1 GB disk
MODEL_MAX_MB=16                       # tiny, since brain is off
STORAGE_DEFAULT_MAX_KB=256

# ── Apex keeps its full confluence, but only STRONG/ELITE emit ────────────
APEX_MIN_SCORE=78
APEX_MAX_BARS_SINCE_BOS=6
APEX_TP_MODE=deepest

# ── Wyckoff quality bar (matches your previous tightening) ───────────────
WYCKOFF_MIN_SCORE=82
WYCKOFF_SWING_MIN_SCORE=86
WYCKOFF_TRAP_GUARD_WIRE=1
WYCKOFF_ALLOW_PRE_BREAK_ENTRY=0
WYCKOFF_REQUIRE_MACRO=1
WYCKOFF_TARGET_MODE=deepest_cluster
WYCKOFF_MIN_RR=2.0


# ═══════════════════════════════════════════════════════════════════════════
# TELEGRAM
# ═══════════════════════════════════════════════════════════════════════════

# Bot token from @BotFather
TELEGRAM_TOKEN="your_bot_token_here"

# Your chat / user ID. Get it from @userinfobot on Telegram.
# Signals go ONLY to this chat. Any other chat is silently ignored.
TELEGRAM_CHAT_ID="your_chat_id_here"

# Optional extra guard — your numeric Telegram user ID. If set, every
# incoming command must come from this exact user, not just this chat.
# ADMIN_USER_ID="123456789"

# Long-polling (required — no webhook on Wispbyte's HTTP-only address)
TELEGRAM_POLLING_ENABLED=true
POLLING_TIMEOUT_SEC=30


# ═══════════════════════════════════════════════════════════════════════════
# BITGET
# ═══════════════════════════════════════════════════════════════════════════

# Required for authenticated endpoints (account balance, positions, orders).
# Public market data (candles, tickers, order book) works without them.
# Leave blank if you only want read-only / signal-only operation.
BITGET_API_KEY=""
BITGET_API_SECRET=""
BITGET_API_PASSPHRASE=""


# ═══════════════════════════════════════════════════════════════════════════
# ACCOUNT & RISK
# ═══════════════════════════════════════════════════════════════════════════

ACCOUNT_BALANCE=10000
ACCOUNT_RISK_PERCENT=1.5
DEFAULT_RISK_REWARD=2.5

# Legacy alias still read by computeTPSL / QUANTUM_RISK_REWARD
QUANTUM_RR=3.2

# Max notional as % of account balance per position (used by position sizing caps)
MAX_POSITION_SIZE=10.0

# Market type + leverage
MARKET_TYPE=futures
FUTURES_LEVERAGE=5.0
FX_LEVERAGE=30.0


# ═══════════════════════════════════════════════════════════════════════════
# SIGNAL THRESHOLDS (used by /threshold and the alert gate)
# ═══════════════════════════════════════════════════════════════════════════

SIGNAL_THRESHOLD=75
SIGNAL_CERT_MIN=75
SIGNAL_AVG_MIN=45
SIGNAL_CONV_MIN=45
SIGNAL_PILLAR_MIN=3
EMIT_CERT_FLOOR=0


# ═══════════════════════════════════════════════════════════════════════════
# LIMIT SAFETY (Bybit 10x)
# ═══════════════════════════════════════════════════════════════════════════

LIMIT_CERT_GATE=true
LIMIT_CERT_MIN=75
LIMIT_LIQ_GATE=true
LIMIT_ALLOW_FALLBACK=true
MAX_LIMIT_PULLBACK_PCT=3
SAFE_LIMIT_PCT=2.5


# ═══════════════════════════════════════════════════════════════════════════
# HTTP CONTROL
# ═══════════════════════════════════════════════════════════════════════════

# Wispbyte injects PORT automatically — leave unset to use its value.
# PORT=10000
SERVER_HOST=0.0.0.0

# Token required by protected POST endpoints (/start, /stop, /apex/scan,
# /wyckoff/scan, /mainbrain/scan, /cont/scan, /cont2/scan).
# Generate with:  openssl rand -hex 32
HTTP_CONTROL_TOKEN=""

# Emergency kill switch — set to 1 to refuse all new signals without stopping
# the process. Useful during volatile events.
EMERGENCY_HALT=0


# ═══════════════════════════════════════════════════════════════════════════
# RUNTIME / DEBUG
# ═══════════════════════════════════════════════════════════════════════════

DEBUG=false

# Circuit breaker for runSignalEngine cycles (existing)
CIRCUIT_BREAK_THRESHOLD=5
CIRCUIT_BREAK_COOLDOWN_MS=60000


# ═══════════════════════════════════════════════════════════════════════════
# OPTIONAL — leave commented unless you use these features
# ═══════════════════════════════════════════════════════════════════════════

# ── Extra data sources ───────────────────────────────────────────────────
# COINGECKO_API_KEY=""
# CRYPTOQUANT_API_KEY=""
# GLASSNODE_API_KEY=""
# ALPHAVANTAGE_API_KEY=""
# NEWSAPI_KEY=""
# DERIBIT_API_KEY=""

# ── Upgrade / experimental engines ───────────────────────────────────────
# WYCKOFF_UPGRADE_ENABLED=1
# WYCKOFF_FOOTPRINT_ENABLED=1
# WYCKOFF_SWING_REQUIRE_INSTITUTIONAL=0

# ── Advanced Apex (Sovereign) gates — only if APEX_SOVEREIGN_ENABLED=1 ───
# SOV_BLACKOUT_ENABLED=1
# SOV_VACUUM_ENABLED=1
# SOV_CROSS_VENUE_ENABLED=1
# SOV_STOP_HUNT_ENABLED=1
# SOV_REGIME_ENABLED=1
# SOV_HARD_RISK_ENABLED=1
# SOV_MAX_RISK_PCT=1.0
# SOV_EMIT_GRADES=S,A

# ── Decision auto-scan (only if DECISION_AUTO_SCAN=true) ─────────────────
# DECISION_AUTO_INTERVAL_MS=300000
# DECISION_AUTO_BATCH_SIZE=80

# ── Main Brain (only if AUTO_MAIN_BRAIN_ENABLED=1) ───────────────────────
# AUTO_MAIN_BRAIN_INTERVAL_MS=900000
# AUTO_MAIN_BRAIN_BATCH_SIZE=40
# AUTO_MAIN_BRAIN_MIN_SCORE=90

# ── Forex (only if you scan FX symbols) ──────────────────────────────────
# FX_LEVERAGE=30.0
