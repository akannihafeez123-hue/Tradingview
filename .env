# Required for Telegram messaging and admin command access
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# Optional extra admin-user check; TELEGRAM_CHAT_ID is still required
ADMIN_USER_ID=
TELEGRAM_POLLING_ENABLED=true
# Optional Neon/Postgres persistence
# Leave DATABASE_URL blank to use local JSON storage only
# Install the "postgres" npm package before enabling Neon
DATABASE_URL=
NEON_HYDRATE_ON_BOOT=1
NEON_FLUSH_INTERVAL_MS=5000
# Optional token for protected HTTP control/status endpoints
HTTP_CONTROL_TOKEN=
# Runtime defaults
PORT=10000
MARKET_TYPE=futures
LOW_BANDWIDTH_MODE=true
# Apex settings
APEX_ENGINE_ENABLED=1
APEX_PRIMARY_TF=15min
# Apex scan limits are fixed in the JavaScript file:
# 50 symbols per batch, every 30 minutes, 1,000 candles per fetch
